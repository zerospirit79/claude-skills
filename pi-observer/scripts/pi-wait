#!/usr/bin/env python3
"""Дождаться, пока pi в каталоге задачи закончит, и выдать вердикт pi-check.

  pi-wait <каталог-задачи> [макс-секунд=540]

Для агентов без фоновых задач (opencode и др.): запустить фазу `pi-start --bg ...`, затем
вызывать pi-wait с лимитом чуть меньше таймаута bash-инструмента агента; пока ждёт — молчит,
токены не тратятся. Если pi стартовал только что и процесса ещё нет — ждёт его появления до 20 с.
Если pi зациклился (одна команда ≥5 раз подряд) — не ждёт до лимита, выходит сразу с вердиктом
(код 1); остановить pi: `pi-stop <каталог>`.
Код выхода: как у pi-check (0 OK, 1 замечания, 3 pi ещё работает — вызвать pi-wait снова).
"""
import glob
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pisession  # noqa: E402

args = sys.argv[1:]
if not args or args[0] in ('-h', '--help'):
    print(__doc__)
    sys.exit(2)
workdir = os.path.abspath(os.path.expanduser(args[0]))
limit = int(args[1]) if len(args) > 1 else 540

start = time.time()
runs = os.path.join(workdir, '.pi_runs')
fresh = os.path.exists(runs) and time.time() - os.path.getmtime(runs) < 30
while fresh and not pisession.pi_pids(workdir) and time.time() - start < 20:
    time.sleep(1)                                   # процесс pi ещё поднимается
looping = None
while pisession.pi_pids(workdir) and time.time() - start < limit:
    time.sleep(5)
    if int(time.time() - start) % 30 < 5:            # раз в ~30 с — не зациклился ли
        ss = pisession.sessions_for(workdir)
        looping = ss and pisession.loop_signal(pisession.events(ss[-1], width=120)[0])
        if looping:
            break
waited = int(time.time() - start)
if looping:
    print(f'pi зациклился (ждал {waited} с) — {looping}', flush=True)
elif pisession.pi_pids(workdir):
    print(f'pi ещё работает (ждал {waited} с) — вызовите pi-wait снова', flush=True)
else:
    # pi-start дописывает PI-EXIT в .out сразу после выхода pi — дать ему до 5 с
    outs = sorted(glob.glob(os.path.join(workdir, '*.out')), key=os.path.getmtime)
    for _ in range(10):
        if not outs or 'PI-EXIT=' in open(outs[-1], errors='replace').read()[-200:]:
            break
        time.sleep(0.5)
    print(f'pi завершился (ждал {waited} с)', flush=True)
check = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'pi-check')
sys.exit(subprocess.run([check, workdir]).returncode)
