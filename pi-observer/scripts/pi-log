#!/usr/bin/env python3
"""Сжатая лента сессии pi: что исполнитель вызывал и что получил.

  pi-log <session-id | путь к .jsonl> [--from N] [--full] [--width W]

Каждая строка: #номер, время, роль. Для toolCall — команда; для toolResult — код выхода
(SCRIPT-EXIT=/exit), isError и хвост вывода; для текста assistant — сам текст.
--from N   показать события начиная с номера N (для инкрементального наблюдения)
--full     не обрезать вывод инструментов
В конце: число событий, последний stopReason, токены.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pisession  # noqa: E402

args = sys.argv[1:]
if not args or args[0] in ('-h', '--help'):
    print(__doc__)
    sys.exit(2)
target, start, full, width = args[0], 0, False, 400
i = 1
while i < len(args):
    if args[i] == '--from':
        start = int(args[i + 1]); i += 1
    elif args[i] == '--full':
        full = True
    elif args[i] == '--width':
        width = int(args[i + 1]); i += 1
    i += 1

path = pisession.find(target)
if not path:
    sys.exit(f'сессия не найдена: {target}')

evs, summary = pisession.events(path, width, full)
for e in evs:
    if e['n'] < start:
        continue
    head = f'#{e["n"]} {e["ts"]}'
    if e['kind'] == 'call':
        print(f'{head} CALL {e["name"]}: {e["text"]}')
    elif e['kind'] == 'result':
        flag = ' ERROR' if e['error'] else ''
        code = f' rc={e["rc"]}' if e['rc'] is not None else ''
        print(f'{head} RESULT {e["name"]}{flag}{code}: {e["text"]}')
    else:
        print(f'{head} {e["kind"]}: {e["text"]}')

print(f'--- {path}\n--- событий: {summary["count"]}, последний stopReason: {summary["stop"]}, '
      f'токенов: {summary["tokens"]}')
